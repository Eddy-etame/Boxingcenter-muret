---
/**
 * LE HERO — un écran, et la porte du club dedans.
 *
 * Ce qu'il fait, dans l'ordre où un Muretain se pose les questions :
 * confirmer qu'il est au bon endroit (le H1), lui donner la raison de rester
 * (les disciplines), nommer le club, dire le bus en une phrase, et ouvrir la
 * porte du club avant le premier défilement.
 *
 * Le plan de l'Éole vit une section plus bas, sous le titre qu'il illustre :
 * ici, il coûtait presque un écran avant le premier mot sur le club. Le second
 * bouton y mène par une ancre.
 *
 * Le H1 est fixé par le cahier des charges : « proche de ».
 */
import { SITE, DESTINATION } from '../data/verite';
import { OFFRES, offresDeLaPage } from '../data/offres';
import { MEILLEUR } from '../data/transports';

/** Les disciplines telles que le club les publie, dans l'ordre des pages. */
const DISCIPLINES = [
  ...offresDeLaPage('boxe-anglaise'),
  ...offresDeLaPage('kick-boxing'),
  ...offresDeLaPage('mma'),
  ...offresDeLaPage('boxe-enfants').slice(0, 1),
]
  // Les intitulés du club, en minuscules dans la phrase — sauf le sigle.
  .map((o) => (o.intitule === 'MMA' ? o.intitule : o.intitule.toLowerCase()))
  .join(', ')
  .replace(/, ([^,]+)$/, ' et $1');

/** Les cotes du club, projetées telles quelles depuis le registre. */
const COTES = DESTINATION.faits.filter((f) => ['Surface', 'Équipement', 'Accueil'].includes(f.cle));
const BUS = MEILLEUR.etapes[0];
---

<section class="hero" aria-labelledby="t-hero">
  <div class="enveloppe">
    <p class="hero__cartouche mono">
      <span class="hero__planche">Boxing Center</span>
      <span aria-hidden="true">·</span>
      <span>à proximité de {SITE.ville}</span>
    </p>

    <div class="hero__texte">
      <h1 id="t-hero" class="hero__titre">
        <span class="hero__ligne">Ton club de boxe</span>
        <span class="hero__ligne hero__ligne--accent">proche de {SITE.ville}.</span>
      </h1>

      <p class="hero__promesse">
        <strong>{DISCIPLINES.charAt(0).toUpperCase() + DISCIPLINES.slice(1)}, à {DESTINATION.nom}.</strong>
        Un seul bus depuis la gare de {SITE.ville}, la {BUS.code}, et tu descends
        dans la rue du club.
      </p>

      <p class="hero__cotes mono">
        <span>{DESTINATION.adresse.split(',')[0]}</span>
        {COTES.map((f) => (
          <>
            <span aria-hidden="true">·</span>
            <span>{f.valeur}</span>
          </>
        ))}
      </p>

      <div class="hero__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver ma séance d’essai</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href="#trajet">
          <span>Le bus, de la gare au club</span>
          <span class="fleche" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    background: var(--papier);
    overflow: hidden;
  }

  /* Le papier a un grain de calque : des lignes de trame très pâles. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--trait-faible) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait-faible) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(120% 90% at 70% 40%, #000 0%, transparent 78%);
    opacity: 0.55;
  }
  .hero > * { position: relative; }

  .hero__cartouche {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    align-items: center;
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
    margin-bottom: var(--e-7);
  }
  .hero__planche { color: var(--signal-texte); font-weight: 700; }

  .hero__texte { max-width: 60rem; }

  .hero__titre { max-width: 15ch; margin-bottom: var(--e-5); }
  .hero__ligne {
    display: block;
    animation: poser 720ms var(--e-sortie) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  .hero__ligne:nth-child(1) { --i: 0; }
  .hero__ligne:nth-child(2) { --i: 1; }
  /* La dernière ligne est cuivre : c'est l'affirmation que la page prouve. */
  .hero__ligne--accent { color: var(--signal-texte); }
  @keyframes poser {
    from { opacity: 0; transform: translateY(0.5em); }
    to { opacity: 1; transform: none; }
  }

  .hero__promesse {
    max-width: 54ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--texte-faible);
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
    animation: poser 720ms var(--e-sortie) 240ms both;
  }
  .hero__promesse strong { color: var(--encre); font-weight: 600; }

  .hero__cotes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-3);
    margin-top: var(--e-5);
    padding-left: calc(var(--e-5) + 2px);
    color: var(--graphite);
    text-transform: none;
    letter-spacing: 0.05em;
    animation: poser 720ms var(--e-sortie) 360ms both;
  }
  .hero__cotes span:first-child { color: var(--encre); font-weight: 700; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
    animation: poser 720ms var(--e-sortie) 480ms both;
  }

  :global(.no-js) .hero__ligne,
  :global(.no-js) .hero__promesse,
  :global(.no-js) .hero__cotes,
  :global(.no-js) .hero__actions { animation: none; opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero__ligne,
    .hero__promesse,
    .hero__cotes,
    .hero__actions { animation: none !important; opacity: 1; transform: none; }
  }
</style>
