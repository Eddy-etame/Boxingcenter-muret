---
/**
 * TRANSPORTS EN COMMUN — le trajet complet, de la gare de Muret au 61 route
 * d'Espagne.
 *
 * Le corps vit dans `components/Transports.astro`, piloté par
 * `data/transports.ts` : les autres sites de la famille changent leur registre
 * et héritent de la page.
 */
import Base from '../layouts/Base.astro';
import Transports from '../components/Transports.astro';
import { SITE, DESTINATION } from '../data/verite';

const QUESTIONS = [
  {
    titre: `Quel bus va de ${SITE.ville} à ${DESTINATION.ville} ?`,
    texte:
      'La 117 Express, du réseau Tisséo. Elle part de la gare de Muret, suit le tracé de l’ancienne nationale 117, traverse Roques, puis marque deux arrêts sur la route d’Espagne à Portet-sur-Garonne : « Ax » et « Jean Jaurès ». Boxing Center Portet-sur-Garonne est au 61 de cette rue.',
  },
  {
    titre: 'Où descendre pour être devant le club ?',
    texte:
      'À l’arrêt « Jean Jaurès », sur la route d’Espagne. Le club est au 61 de la même rue, dans la continuité de l’axe que le bus vient de suivre.',
  },
  {
    titre: 'Et en train, depuis la gare de Muret ?',
    texte:
      'La gare de Muret et celle de Portet-Saint-Simon se suivent sur la ligne de Toulouse à Bayonne. À l’arrivée, la Linéo 5 part du parvis de la gare de Portet et dessert l’arrêt « Route d’Espagne ». Deux étapes, les deux à l’abri de la circulation.',
  },
  {
    titre: 'Je pars de Roques.',
    texte:
      'Roques est sur le parcours de la 117 Express, entre Muret et Portet-sur-Garonne. Tu montes en route et tu descends route d’Espagne : la même ligne fait tout le trajet.',
  },
  {
    titre: 'Les horaires sont où ?',
    texte:
      'Chez Tisséo, qui les publie et les met à jour à chaque saison. Chaque étape de cette page ouvre la fiche officielle de sa ligne, avec l’horaire du jour.',
  },
];
---

<Base page="transports" faq={QUESTIONS}>
  <Transports />
</Base>
