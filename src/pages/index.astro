---
/**
 * L'ACCUEIL — neuf sections, dans l'ordre des questions d'un Muretain.
 *
 * Un Muretain qui tape « club de boxe Muret » se pose ses questions dans un
 * ordre, et cet ordre est celui de la page. À Muret, « c'est où » et « j'y vais
 * comment » sont UNE SEULE question : un bus dépose dans la rue du club. La
 * section 02 répond donc aux deux d'un coup, et le plan de l'Éole vit sous ce
 * titre-là, pas dans le héros.
 *
 *   01 Le héros — c'est pour moi ? et je fais quoi tout de suite ?
 *   02 Le bus et le club — c'est où, j'y vais comment ?
 *   03 La salle — c'est quoi comme salle, c'est sérieux ?
 *   04 Les cours — qu'est-ce que je peux y faire, exactement ?
 *   05 Le moteur — lequel est pour moi, et quand ?
 *   06 La première fois — je n'ai jamais boxé, qu'est-ce qui va m'arriver ?
 *   07 Les questions — ce qui me reste à vérifier
 *   08 Le secteur — j'habite à côté, ça marche pareil ?
 *   09 Décider — je fais quoi maintenant ?
 *
 * Chaque fait revient sous une forme nouvelle, attachée à une chose nouvelle.
 * Aucun chiffre n'est écrit à la main : tout vient des registres. Chaque
 * section se referme sur une porte du club dont le libellé n'a pas encore servi.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PlanEole from '../components/PlanEole.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, DESTINATION, VILLE, LIMITROPHES, NOTE_SECTEUR, CONTACT } from '../data/verite';
import { OFFRES, offresDeLaPage } from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { ITINERAIRES, MEILLEUR, ARRIVEE, enLettres } from '../data/transports';

/** « a, b, c et d » depuis une liste, sans jamais l'écrire à la main. */
const enumerer = (noms: readonly string[]) =>
  noms.length > 1 ? `${noms.slice(0, -1).join(', ')} et ${noms[noms.length - 1]}` : noms[0] ?? '';

/** Les cinq portes du site, avec les intitulés exacts du club derrière chacune. */
const PORTES = [
  { id: 'boxe-anglaise', nom: 'Boxe anglaise' },
  { id: 'mma', nom: 'MMA et grappling' },
  { id: 'kick-boxing', nom: 'Kick-boxing' },
  { id: 'boxe-enfants', nom: 'Cours enfants' },
  { id: 'boxing-fitness', nom: 'Boxing fitness' },
] as const;

const BUS = MEILLEUR.etapes[0];
const TRAIN = ITINERAIRES.find((i) => i.id !== MEILLEUR.id);
const COTE = (cle: string) => DESTINATION.faits.find((f) => f.cle === cle)?.valeur ?? '';
const COMBIEN_COURS = enLettres(OFFRES.length);
const COMBIEN_COMMUNES = enLettres(LIMITROPHES.length);
const ROQUES = LIMITROPHES.find((c) => c.note);
const AUTRES = LIMITROPHES.filter((c) => !c.note).map((c) => c.nom);

/**
 * Les questions telles qu'on les pose. Chaque réponse s'ouvre sur ce qui est
 * vrai, et c'est ici que vit la preuve : l'adresse, la cage, le train, l'enfant.
 */
const QUESTIONS = [
  {
    titre: `Où est le club de boxe le plus proche de ${SITE.ville} ?`,
    texte: `Au ${DESTINATION.adresse}. ${COTE('Surface')}, ${COTE('Équipement')}, ouvert ${DESTINATION.horaires.valeur}. La ${BUS.code} part de la gare de ${SITE.ville} et s’arrête dans cette rue.`,
  },
  {
    titre: 'Il y a une vraie cage pour le MMA ?',
    texte: `Oui, et l’entraînement se fait dedans. ${DESTINATION.singularite} Le grappling et le jiu-jitsu brésilien sont des cours à part, en travail au sol.`,
  },
  {
    titre: 'Et la boxe thaï ?',
    texte: 'Le club publie le kick-boxing — la boxe pieds-poings — pour les adultes comme pour les enfants et les ados. La boxe thaï ajoute les coudes et les genoux : si c’est bien elle que tu cherches, dis-le dans ton message et on te dit où elle se pratique dans le réseau.',
  },
  {
    titre: 'Je peux venir en train ?',
    texte: TRAIN
      ? `Oui. ${TRAIN.etapes[0].code}, de la gare de ${SITE.ville} à ${TRAIN.etapes[0].a}, puis ${TRAIN.etapes[1].code} depuis le parvis : son premier arrêt est « ${TRAIN.etapes[1].a} », sur la ${ARRIVEE.rue}. La ${BUS.code} reste le trajet le plus simple : un seul bus, sans changement.`
      : `La ${BUS.code} reste le trajet le plus simple : un seul bus, sans changement.`,
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte: `Oui, sur ${enLettres(offresDeLaPage('boxe-enfants').length)} niveaux : ${enumerer(offresDeLaPage('boxe-enfants').map((o) => o.intitule))}. Tout se fait en touché contrôlé, et les âges exacts sont sur le planning du club.`,
  },
  {
    titre: `J’habite ${enumerer(AUTRES.slice(3, 5))} ou ${ROQUES?.nom ?? ''}.`,
    texte: `Ça marche pareil. ${NOTE_SECTEUR} Depuis les autres communes, ce sont les mêmes axes et le même club.`,
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LE BUS ET LE CLUB ─────────── */}
  <section class="section creuse trajet" id="trajet" aria-labelledby="t-trajet">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">02</span><span>Y aller</span></p>
      <div class="trajet__tete">
        <h2 id="t-trajet">
          Un seul bus&nbsp;: tu montes à la gare de {SITE.ville},<br />
          <span class="trajet__accent">tu descends dans la rue du club.</span>
        </h2>
        <p class="lead faible trajet__intro">
          Les cours de boxe accessibles depuis {SITE.ville} tiennent en une
          ligne&nbsp;: la {BUS.code}, de {BUS.de} à l’arrêt «&nbsp;{ARRIVEE.arret}&nbsp;»,
          {BUS.jours}. {ARRIVEE.phrase} En voiture, {DESTINATION.acces.replace(/^Par/, 'par').replace(/\.$/, '')}.
        </p>
      </div>

      <PlanEole />

      <div class="trajet__actions">
        <a class="bouton bouton--signal" href={DESTINATION.site} rel="noopener">
          <span>Ouvrir le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={route('transports').chemin}>
          <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 03 — LA SALLE ─────────── */}
  <section class="section salle" aria-labelledby="t-salle">
    <div class="enveloppe salle__inner">
      <div class="salle__texte">
        <p class="cartouche"><span class="cartouche__num">03</span><span>La salle</span></p>
        <h2 id="t-salle">
          {COTE('Surface')},<br />
          <span class="salle__accent">{COTE('Équipement')}.</span>
        </h2>
        <p class="lead">
          Pour un club de MMA près de {SITE.ville}, c’est ici que l’entraînement
          se fait dans la cage. <strong>{DESTINATION.singularite}</strong>
        </p>
        <p class="faible">
          Un club de sport de combat complet, proche de {SITE.ville}. Sur le ring, les cours de boxe
          anglaise et de kick-boxing. Dans la
          cage, le MMA. Sur les tatamis, le grappling et le jiu-jitsu. Aux sacs,
          la préparation physique et le Lady Boxing. Les coachs corrigent au
          geste près, et le club accueille {DESTINATION.horaires.valeur}.
        </p>
        <dl class="salle__faits">
          <div><dt class="mono">Accueil</dt><dd>{COTE('Accueil')}</dd></div>
          <div><dt class="mono">Téléphone</dt><dd><a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a></dd></div>
        </dl>
        <a class="bouton" href={DESTINATION.plannings} rel="noopener">
          <span>Voir le planning du club</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
      <Photo slug={ROLES.signature} sizes="(max-width: 62rem) 100vw, 46vw" ratio="4 / 5" legende class="salle__image" />
    </div>
  </section>

  {/* ─────────── 04 — LES COURS ─────────── */}
  <section class="section encre cours" aria-labelledby="t-cours">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">04</span><span>Les cours</span></p>
      <div class="cours__tete">
        <h2 id="t-cours">
          {COMBIEN_COURS.charAt(0).toUpperCase() + COMBIEN_COURS.slice(1)} cours, adultes et enfants,<br />
          avec les noms que tu verras sur le planning.
        </h2>
        <p class="lead faible cours__intro">
          {COMBIEN_COURS.charAt(0).toUpperCase() + COMBIEN_COURS.slice(1)} cours de sports de combat à proximité de {SITE.ville},
          sous l’intitulé exact que le club publie. Chaque porte a sa page ici.
        </p>
      </div>

      <ol class="cours__liste">
        {PORTES.map((p, i) => {
          const offres = offresDeLaPage(p.id);
          return (
            <li class="reveler" style={`--retard:${i * 60}ms`}>
              <a class="cours__page" href={route(p.id).chemin}>
                <span class="mono cours__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cours__corps">
                  <span class="cours__nom">{p.nom}</span>
                  <span class="cours__intitules">
                    {offres.map((o, j) => (
                      <>
                        {j > 0 && <span aria-hidden="true"> · </span>}
                        <b>{o.intitule}</b>
                      </>
                    ))}
                  </span>
                  <span class="cours__detail">{offres[0]?.detail}</span>
                </span>
                <span class="fleche" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ol>

      <p class="cours__source mono">
        <a class="lien" href={DESTINATION.activites} rel="noopener">La page activités du club ↗</a>
      </p>
    </div>
  </section>

  {/* ─────────── 05 — LE MOTEUR ─────────── */}
  <Seance titre={'Tu sais quel bus prendre.\nChoisis ton cours, et le moment.'} numero="05" />

  {/* ─────────── 06 — LA PREMIÈRE FOIS ─────────── */}
  <section class="section creuse premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" legende />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">06</span><span>La première fois</span></p>
        <h2 id="t-premiere">Le premier jour, tu apprends un geste et tu le répètes au sac.</h2>
        <p class="lead faible">
          Le débutant complet est le profil le plus fréquent chez les nouveaux
          inscrits. Voilà ta première séance, pas à pas.
        </p>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Tu apportes une tenue de sport et de l’eau.</strong> Pour les gants et les bandes, tu demandes au club en arrivant.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Tu t’échauffes à la corde, puis tu apprends un geste.</strong> Décomposé lentement, répété au sac, corrigé aux pattes d’ours par le coach.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Tu frappes, et c’est tout.</strong> L’opposition vient bien plus tard, et seulement si tu la demandes.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars essoufflé, et content d’être venu.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <div class="premiere__actions">
          <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
            <span>Les tarifs et la séance d’essai</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
            Le déroulé complet, minute par minute →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 07 — LES QUESTIONS ─────────── */}
  <section class="section questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">07</span><span>Avant de venir</span></p>
        <h2 id="t-questions">Les questions qui te restent<br />avant de venir.</h2>
        <p class="lead faible">
          Chaque réponse commence par ce qui existe. Pour le reste, le club
          répond au <a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a>.
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 08 — LE SECTEUR ─────────── */}
  <section class="section creuse secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">08</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          {COMBIEN_COMMUNES.charAt(0).toUpperCase() + COMBIEN_COMMUNES.slice(1)} communes autour de {SITE.ville},<br />
          <span class="secteur__accent">et {ROQUES?.nom} sur le parcours de la {BUS.code}.</span>
        </h2>
        <p class="lead faible secteur__intro">
          Boxing Center accueille les {SITE.gentile} dans son club de
          {' '}{DESTINATION.ville}, et les habitants des communes voisines par les
          mêmes axes. {NOTE_SECTEUR}
        </p>
      </div>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied faible">
        {VILLE.statut.valeur.charAt(0).toUpperCase() + VILLE.statut.valeur.slice(1)},
        {' '}{VILLE.population.valeur}, entre {VILLE.rivieres.valeur}. Accès par
        {' '}{VILLE.routes.valeur}.
      </p>
      <a class="bouton" href={route('transports').chemin}>
        <span>Ton départ, commune par commune</span>
        <span class="fleche" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* ─────────── 09 — DÉCIDER ─────────── */}
  <section class="section convergence" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Décider</span></p>
      <h2 id="t-convergence">
        La {BUS.code} roule {BUS.jours}.<br />
        <span class="convergence__accent">Choisis ton jour.</span>
      </h2>
      <p class="lead convergence__texte">
        La séance d’essai se réserve sur le site du club. Si tu hésites, décris
        ta semaine en deux lignes et on te répond avec la discipline et le
        créneau qui tiennent.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Ma question, par écrit</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 Le bus et le club ──────────────────────────────────────────── */
  .trajet__tete {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--e-5) var(--e-8);
    align-items: end;
  }
  @media (max-width: 62rem) { .trajet__tete { grid-template-columns: 1fr; } }
  .trajet h2 { max-width: 20ch; }
  .trajet__accent { color: var(--signal-texte); }
  .trajet__intro { max-width: 52ch; }
  .trajet__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  /* ── 03 La salle ───────────────────────────────────────────────────── */
  .salle__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .salle__inner { grid-template-columns: 1fr; gap: var(--e-7); } }
  .salle h2 { max-width: 14ch; margin-bottom: var(--e-5); }
  .salle__accent { color: var(--signal-texte); }
  .salle .lead { max-width: 46ch; margin-bottom: var(--e-4); }
  .salle .lead strong { color: var(--encre); font-weight: 600; }
  .salle .faible { max-width: 52ch; }
  .salle__faits { margin: var(--e-6) 0; }
  .salle__faits > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--e-3);
    padding: var(--e-3) 0;
    border-top: 1px solid var(--trait);
    font-size: var(--t-petit);
  }
  .salle__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  .salle__faits dt { color: var(--graphite); }
  .salle__faits dd { margin: 0; font-weight: 600; }
  @media (max-width: 34rem) { .salle__faits > div { grid-template-columns: 1fr; gap: 0.2rem; } }

  /* ── 04 Les cours ──────────────────────────────────────────────────── */
  .cours__tete {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .cours__tete { grid-template-columns: 1fr; } }
  .cours h2 { max-width: 22ch; }
  .cours__intro { max-width: 48ch; }
  .cours__liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--trait); }
  .cours__liste > li { border-bottom: 1px solid var(--trait); }
  .cours__page {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-5) 0;
    color: inherit;
    text-decoration: none;
    transition: transform var(--d-rapide) var(--e-sortie);
  }
  .cours__page:hover { transform: translateX(6px); }
  .cours__page .fleche { color: var(--signal-texte); }
  .cours__num { color: var(--signal-texte); font-weight: 700; }
  .cours__corps { display: grid; gap: 0.3rem; min-width: 0; }
  .cours__nom { font-family: var(--police-titre); font-size: var(--t-h3); font-weight: 700; }
  .cours__intitules { font-size: var(--t-petit); color: var(--texte-faible); }
  .cours__intitules b { color: var(--texte); font-weight: 600; }
  .cours__detail { font-size: var(--t-petit); color: var(--texte-faible); }
  .cours__source { margin-top: var(--e-5); }
  @media (max-width: 44rem) { .cours__page { grid-template-columns: 2.4rem 1fr auto; } }

  /* ── 06 La première fois ───────────────────────────────────────────── */
  .premiere__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .premiere__inner { grid-template-columns: 1fr; gap: var(--e-7); } }
  .premiere h2 { max-width: 20ch; margin-bottom: var(--e-4); }
  .premiere .lead { max-width: 46ch; margin-bottom: var(--e-5); }
  .premiere__etapes { list-style: none; margin: 0 0 var(--e-6); padding: 0; display: grid; gap: var(--e-4); }
  .premiere__etapes li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--e-3);
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
  }
  .premiere__etapes li:last-child { border-bottom: 0; }
  .premiere__etapes .mono { color: var(--signal-texte); font-weight: 700; }
  .premiere__etapes p { margin: 0; color: var(--texte-faible); }
  .premiere__etapes strong { color: var(--texte); font-weight: 600; }
  .premiere__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-4); }
  .premiere__lien { font-weight: 600; }

  /* ── 07 Les questions ──────────────────────────────────────────────── */
  .questions__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--e-8);
    align-items: start;
  }
  @media (max-width: 62rem) { .questions__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .questions__tete h2 { margin-bottom: var(--e-4); }
  .questions__tete .lead { max-width: 36ch; }

  /* ── 08 Le secteur ─────────────────────────────────────────────────── */
  .secteur__tete {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-6);
  }
  @media (max-width: 62rem) { .secteur__tete { grid-template-columns: 1fr; } }
  .secteur h2 { max-width: 20ch; }
  .secteur__accent { color: var(--signal-texte); }
  .secteur__intro { max-width: 52ch; }
  .secteur__liste {
    list-style: none;
    margin: 0 0 var(--e-5);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--e-2) var(--e-5);
  }
  .secteur__item {
    display: grid;
    gap: 0.1rem;
    padding: var(--e-3) 0;
    border-top: 1px solid var(--trait);
