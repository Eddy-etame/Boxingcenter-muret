---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, DESTINATION, VILLE, LIMITROPHES, CONTACT } from '../data/verite';
import { OFFRES } from '../data/offres';
import { route } from '../data/routes';
import { ITINERAIRES, MEILLEUR } from '../data/transports';

/**
 * Les questions que les Muretains tapent réellement, avec la réponse honnête.
 *
 * Elles portent les requêtes locales — mais parce qu'elles y répondent, pas
 * pour les placer. On dit toujours ce qui existe : un club au bout d'une ligne, ce qu'il
 * propose, comment on y va. Jamais ce qui manque.
 */
const QUESTIONS = [
  {
    titre: 'Où est le club de boxe le plus proche de Muret ?',
    texte:
      "Au 61 route d’Espagne, à Portet-sur-Garonne. Boxing Center y tient 600 m² avec un ring et une cage MMA. En voiture, tu prends l’A64 direction Toulouse, sortie Portet. En bus, la 117 Express part de la gare de Muret et s’arrête dans la rue du club.",
  },
  {
    titre: 'Qu’est-ce qu’on peut y pratiquer ?',
    texte:
      "Neuf cours : boxe anglaise, kick-boxing, MMA, grappling et jiu-jitsu brésilien, Lady Boxing, préparation physique, Baby boxe, boxe éducative et kick-boxing enfants/ados. Tu peux changer en cours d’année.",
  },
  {
    titre: 'Je n’ai jamais fait de sport de combat. Je peux venir ?',
    texte:
      "Oui, c’est le cas de la plupart des gens qui s’inscrivent. Pas de test à l’entrée, pas de niveau demandé. Une première séance, c’est de l’échauffement, un geste travaillé lentement, du sac et des pattes d’ours. Tu frappes, personne ne te frappe.",
  },
  {
    titre: 'Il y a une vraie cage pour le MMA ?',
    texte:
      "Oui, et l’entraînement se fait dedans. C’est la seule du réseau Boxing Center, donc la salle MMA à viser depuis Muret. Le grappling et le jiu-jitsu brésilien sont des cours à part, sans aucune frappe.",
  },
  {
    titre: 'Et la boxe thaï ?',
    texte:
      "Le club publie le kick-boxing — la boxe pieds-poings — pour les adultes comme pour les enfants et les ados. La boxe thaï autorise en plus les coudes et les genoux : si c’est bien elle que tu cherches, dis-le dans ton message et on te dit où elle se pratique dans le réseau.",
  },
  {
    titre: 'Comment on y va sans voiture ?',
    texte:
      "La 117 Express part de la gare de Muret, suit l’ancienne nationale 117 et s’arrête deux fois sur la route d’Espagne, à Portet. Descends à « Jean Jaurès » : le club est au 61. Il y a aussi le train, avec la gare de Portet-Saint-Simon et la L5 pour finir.",
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte:
      "Oui, sur trois niveaux : la Baby boxe pour commencer, la boxe éducative, puis le kick-boxing enfants/ados. Tout se fait en touché contrôlé. Les âges exacts sont sur le planning du club.",
  },
  {
    titre: 'J’habite Seysses, Eaunes ou Roques.',
    texte:
      "Ça marche pareil. Les douze communes autour de Muret prennent les mêmes axes, et Roques est sur le parcours de la 117 Express : tu montes en route et tu descends au club.",
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LA PROXIMITÉ, PROUVÉE PAR L'IMAGE ─────────── */}
  <section class="section proximite" aria-labelledby="t-proximite">
    <div class="enveloppe proximite__inner">
      <div class="proximite__texte">
        <p class="cartouche"><span class="cartouche__num">02</span><span>Le club</span></p>
        <h2 id="t-proximite">
          600 m², un ring,<br />
          <span class="proximite__accent">une cage.</span>
        </h2>
        <p class="lead">
          <strong>Boxing Center accueille les {SITE.gentile}</strong> dans son club de
          {DESTINATION.ville}, sur la route d’Espagne — {DESTINATION.horaires.valeur}.
        </p>
        <p class="faible">
          C’est un club de sports de combat complet&nbsp;: un ring, une cage MMA, des tatamis, et des
          coachs qui corrigent au geste près. {DESTINATION.singularite}
        </p>
        <dl class="proximite__faits">
          <div><dt class="mono">Adresse</dt><dd>{DESTINATION.adresse}</dd></div>
          <div><dt class="mono">Depuis Muret</dt><dd>{DESTINATION.acces}</dd></div>
          <div><dt class="mono">Téléphone</dt><dd><a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a></dd></div>
        </dl>
        <a class="bouton proximite__lien" href={DESTINATION.site} rel="noopener">
          <span>Ouvrir le site du club</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>

      {/* Le calque se lève : le plan devient la salle. */}
      <Photo
        slug="club-boxe-muret"
        sizes="(max-width: 62rem) 100vw, 46vw"
        ratio="4 / 5"
        class="proximite__image"
      />
    </div>
  </section>

  {/* ─────────── 03 — LE MOTEUR ─────────── */}
  <Seance />

  {/* ─────────── 04 — LES NEUF DISCIPLINES, DANS LES MOTS DU CLUB ─────────── */}
  <section class="section encre disciplines" aria-labelledby="t-disciplines">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">04</span><span>Neuf disciplines</span></p>
      <div class="disciplines__tete">
        <h2 id="t-disciplines">
          Ce que le club publie,<br />dans ses propres mots.
        </h2>
        <p class="lead faible disciplines__intro">
          Pas « boxe et MMA » en bloc&nbsp;: les neuf intitulés exacts, relevés sur
          la page activités du club. Si un nom ne figure pas ici, c’est qu’il ne
          figure pas chez eux.
        </p>
      </div>

      <ol class="disciplines__liste">
        {OFFRES.map((o, i) => (
          <li class="reveler" style={`--retard:${i * 45}ms`}>
            <span class="mono disc__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="disc__corps">
              <h3 class="disc__nom">{o.intitule}</h3>
              <p class="disc__detail">{o.detail}</p>
            </div>
            {o.ages && <span class="mono disc__age">{o.ages}</span>}
          </li>
        ))}
      </ol>

      <p class="disciplines__source mono">
        <a class="lien" href={DESTINATION.activites} rel="noopener">Les neuf disciplines chez le club ↗</a>
      </p>
    </div>
  </section>

  {/* ─────────── 05 — LA PREUVE VISUELLE ─────────── */}
  <section class="section preuve" aria-labelledby="t-preuve">
    <div class="enveloppe preuve__tete">
      <p class="cartouche"><span class="cartouche__num">05</span><span>Sur place</span></p>
      <h2 id="t-preuve">Voilà la salle.</h2>
      <p class="lead faible">
        La cage, un soir de semaine. Toutes les photos de ce site ont été prises
        au club.
      </p>
    </div>
    <div class="enveloppe">
      <Photo slug="cage-mma-muret" sizes="100vw" ratio="16 / 9" class="preuve__image" />
      <p class="mono preuve__legende">Dans la cage — {DESTINATION.nom}</p>
    </div>
  </section>

  {/* ─────────── 06 — LA PREMIÈRE SÉANCE ─────────── */}
  <section class="section creuse premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug="pattes-d-ours-muret" sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">06</span><span>La première fois</span></p>
        <h2 id="t-premiere">Personne n’est arrivé en sachant boxer.</h2>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Tu apportes une tenue de sport et de l’eau.</strong> Rien de technique. Pour les gants et les bandes, les conditions de prêt appartiennent au club&nbsp;: demande-les en arrivant.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Tu ne combats pas.</strong> Une première séance, c’est de la corde, du geste décomposé, du sac et des pattes d’ours. L’opposition vient bien plus tard, et seulement si tu la veux.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Tu es le débutant du fond, et personne ne regarde.</strong> Tout le monde l’a été. Chacun est occupé à sa propre séance.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars courbaturé, pas humilié.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
          Le déroulé complet, minute par minute →
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 07 — L'AMPLITUDE ─────────── */}
  <section class="section amplitude" aria-labelledby="t-amplitude">
    <div class="enveloppe amplitude__inner">
      <div>
        <p class="cartouche"><span class="cartouche__num">07</span><span>L’amplitude</span></p>
        <p class="amplitude__grand">
          <span>{DESTINATION.ouvertureTexte}</span>
          <span class="amplitude__fleche" aria-hidden="true">→</span>
          <span>{DESTINATION.fermetureTexte}</span>
        </p>
        <p class="mono amplitude__jours">six jours sur sept</p>
      </div>
      <div class="amplitude__texte">
        <h2 id="t-amplitude">Onze heures et demie d’ouverture par jour.</h2>
        <p class="lead faible">
          C’est la donnée qui compte le plus quand on vient d’une autre commune&nbsp;:
          elle veut dire que tu n’as pas à faire coïncider ta vie avec un créneau
          unique. C’est le créneau qui s’adapte à ta semaine, pas l’inverse.
        </p>
        <ul class="amplitude__args">
          <li><span class="amplitude__tiret" aria-hidden="true"></span>Tu viens quand ta journée te le permet</li>
          <li><span class="amplitude__tiret" aria-hidden="true"></span>Compatible avec un travail, des études, une famille</li>
          <li><span class="amplitude__tiret" aria-hidden="true"></span>Un rythme régulier reste tenable toute l’année</li>
        </ul>
        <a class="bouton" href={DESTINATION.plannings} rel="noopener">
          <span>Voir le planning détaillé</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 08 — Y ALLER SANS VOITURE ─────────── */}
  <section class="section trajet" aria-labelledby="t-trajet">
    <div class="enveloppe trajet__inner">
      <div class="trajet__texte">
        <p class="cartouche"><span class="cartouche__num">08</span><span>Y aller</span></p>
        <h2 id="t-trajet">
          Un seul bus,<br />
          <span class="trajet__accent">de la gare de Muret au 61.</span>
        </h2>
        <p class="lead faible">{MEILLEUR.resume}</p>
        <div class="trajet__actions">
          <a class="bouton bouton--signal" href={route('transports').chemin}>
            <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
          </a>
          <a class="bouton" href={DESTINATION.plannings} rel="noopener">
            <span>Le planning du club</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <ol class="trajet__lignes">
        {ITINERAIRES.map((it, i) => (
          <li class="reveler" style={`--retard:${i * 80}ms`}>
            <a href={`${route('transports').chemin}?trajet=${it.id}`}>
              <span class={`trajet__code trajet__code--${it.etapes[0].mode}`}>{it.etapes[0].code}</span>
              <span class="trajet__parcours">{it.onglet}</span>
              <span class="mono trajet__jours">
                {it.etapes.length === 1 ? 'direct' : `correspondance à ${it.etapes[0].a}`}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ─────────── 09 — LES QUESTIONS ─────────── */}
  <section class="section creuse questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">09</span><span>Ce qu’on nous demande</span></p>
        <h2 id="t-questions">Les questions qu’on nous pose<br />le plus souvent.</h2>
        <p class="lead faible">
          Les réponses sont courtes. Si la tienne n’y est pas, écris-nous&nbsp;:
          on répond vite.
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 10 — LE SECTEUR ─────────── */}
  <section class="section secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">10</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Tu habites une commune à côté&nbsp;?<br />
          <span class="secteur__accent">On a prévu ça aussi.</span>
        </h2>
        <p class="lead faible secteur__intro">
          {VILLE.statut.valeur.charAt(0).toUpperCase() + VILLE.statut.valeur.slice(1)},
          {' '}{VILLE.population.valeur}, entre {VILLE.rivieres.valeur}. Le raisonnement de
          cette page ne s’arrête pas aux limites de la commune&nbsp;: depuis les
          communes voisines, ce sont les mêmes axes et le même club.
        </p>
      </div>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied">
        Boxing Center accueille les habitants de Muret et du {SITE.secteur} dans son
        club de {DESTINATION.ville}, en {SITE.departement}. Accès par
        {' '}{VILLE.routes.valeur}.
      </p>
    </div>
  </section>

  {/* ─────────── 11 — ADER, LE FAIT LOCAL ─────────── */}
  <section class="section encre ader" aria-labelledby="t-ader">
    <div class="enveloppe ader__inner">
      <div>
        <p class="cartouche"><span class="cartouche__num">11</span><span>Muret</span></p>
        <h2 id="t-ader">Muret, et le club à Portet.</h2>
        <p class="lead">
          Muret compte {VILLE.population.valeur.replace(' (2023)', '')} et c’est la
          sous-préfecture de la Haute-Garonne. Le club, lui, est à
          Portet-sur-Garonne, sur la route d’Espagne.
        </p>
        <p class="faible">
          En voiture, tu prends l’A64 direction Toulouse et tu sors à Portet. En
          bus, la 117 Express part de la gare et s’arrête dans la rue du club. En
          train, la gare de Portet-Saint-Simon est sur la même ligne que celle de
          Muret. Le club est ouvert du lundi au samedi, de 10h à 21h30 : tu
          trouveras un créneau qui rentre dans ta semaine.
        </p>
      </div>
      <div class="ader__photo">
        <Photo slug="entrainement-boxe-muret" sizes="(max-width: 62rem) 100vw, 42vw" ratio="4 / 3" />
      </div>
    </div>
  </section>

  {/* ─────────── 12 — CONVERGENCE ─────────── */}
  <section class="section convergence" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">12</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Une ligne de bus,<br />
        <span class="convergence__accent">et tu y es.</span>
      </h2>
      <p class="lead convergence__texte">
        Si tu sais déjà ce que tu cherches, le planning du club te dira quand venir.
        Si tu hésites, décris-nous ta semaine en deux lignes — on te répond avec la
        discipline et le créneau qui tiennent vraiment.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={route('contact').chemin}>
          <span>Poser ma question</span>
          <span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={DESTINATION.plannings} rel="noopener">
          <span>Voir le planning</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 Proximité ──────────────────────────────────────────────────── */
  .proximite__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .proximite__inner { grid-template-columns: 1fr; gap: var(--e-7); } }
  .proximite h2 { max-width: 12ch; margin-bottom: var(--e-5); }
  .proximite__accent { color: var(--signal-texte); }
  .proximite .lead { max-width: 46ch; margin-bottom: var(--e-4); }
  .proximite .lead strong { font-weight: 600; }
  .proximite .faible { max-width: 52ch; }

  .proximite__faits { margin: var(--e-6) 0; }
  .proximite__faits > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--e-3);
    padding: var(--e-3) 0;
    border-top: 1px solid var(--trait);
    font-size: var(--t-petit);
  }
  .proximite__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  @media (max-width: 34rem) { .proximite__faits > div { grid-template-columns: 1fr; gap: 0.2rem; } }
  .proximite__faits dt { color: var(--graphite); padding-top: 0.15em; }
  .proximite__faits dd { margin: 0; }

  /* ── 04 Disciplines ────────────────────────────────────────────────── */
  .disciplines__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .disciplines__tete { grid-template-columns: 1fr; } }
  .disciplines__intro { max-width: 46ch; }

  .disciplines__liste { list-style: none; counter-reset: none; }
  .disciplines__liste li {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--e-4);
    align-items: baseline;
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
    transition: padding-left var(--d-normal) var(--e-sortie);
  }
  .disciplines__liste li:last-child { border-bottom: 1px solid var(--trait); }
  .disciplines__liste li:hover { padding-left: var(--e-3); }
  @media (max-width: 44rem) {
    .disciplines__liste li { grid-template-columns: 2.25rem 1fr; }
  }
  .disc__num { color: var(--signal-texte); font-weight: 700; }
  .disc__nom { font-size: var(--t-h3); margin-bottom: 0.2rem; }
  .disc__detail { font-size: var(--t-petit); color: var(--texte-faible); max-width: 56ch; }
  .disc__age { color: var(--graphite); }

  .disciplines__source { margin-top: var(--e-5); color: var(--graphite); text-transform: none; letter-spacing: 0.04em; }

  /* ── 05 Preuve ─────────────────────────────────────────────────────── */
  .preuve__tete { max-width: 56rem; margin-bottom: var(--e-7); }
  .preuve h2 { max-width: 18ch; margin-bottom: var(--e-4); }
  .preuve__legende { margin-top: var(--e-3); color: var(--graphite); text-transform: none; letter-spacing: 0.04em; }

  /* ── 06 Première séance ────────────────────────────────────────────── */
  .premiere__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .premiere__inner { grid-template-columns: 1fr; } }
  .premiere h2 { max-width: 16ch; margin-bottom: var(--e-6); }
  .premiere__etapes { list-style: none; display: grid; }
  .premiere__etapes li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--e-4);
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
  }
  .premiere__etapes .mono { color: var(--signal-texte); padding-top: 0.3em; font-weight: 700; }
  .premiere__etapes p { font-size: var(--t-petit); color: var(--texte-faible); max-width: 56ch; }
  .premiere__etapes strong { color: var(--encre); font-weight: 600; }
  .premiere__lien { display: inline-block; margin-top: var(--e-5); font-size: var(--t-petit); }

  /* ── 07 Amplitude ──────────────────────────────────────────────────── */
  .amplitude__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-7) var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .amplitude__inner { grid-template-columns: 1fr; } }
  .amplitude__grand {
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--police-titre);
    font-size: var(--t-display);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }
  .amplitude__fleche { color: var(--signal-texte); font-size: 0.45em; }
  .amplitude__jours { margin-top: var(--e-3); color: var(--signal-texte); letter-spacing: 0.18em; }
  .amplitude__texte h2 { max-width: 18ch; margin-bottom: var(--e-4); }
  .amplitude__texte .lead { max-width: 48ch; }
  .amplitude__args { list-style: none; display: grid; gap: var(--e-3); margin: var(--e-6) 0; }
  .amplitude__args li { display: flex; align-items: baseline; gap: var(--e-3); font-size: var(--t-petit); }
